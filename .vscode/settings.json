{
  "C_Cpp.default.cppStandard": "c++20",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/include",
    "${workspaceFolder}/**"
  ],
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/build",
    "--background-index"
  ],
  "cSpell.words": [
    "BCSE",
    "CMPLT",
    "ctest",
    "DCOMPILER",
    "DEXPECTED",
    "DSOURCE",
    "ebnf",
    "EBNF",
    "edulang",
    "Genever",
    "Kaufmann",
    "LALR",
    "linearizes",
    "lvalue",
    "Mittal",
    "Nystrom",
    "Rishit",
    "rustc",
    "sandboxed",
    "Sethi",
    "subexpression",
    "Torczon",
    "Ullman"
  ]
}
