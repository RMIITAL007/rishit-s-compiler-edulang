{
  "name": "edulang-web-playground",
  "version": "1.0.0",
  "description": "Professional Web Playground for the EduLang C++ Compiler",
  "type": "module",
  "scripts": {
    "server": "tsx src/server.ts",
    "server:dev": "tsx watch src/server.ts",
    "dev:frontend": "vite",
    "dev": "concurrently -k -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run server\" \"npm run dev:frontend\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "tsx src/test_parser.ts",
    "start": "tsx src/server.ts"
  },

  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  }
}
